# ========================
# DriveDock .gitignore
# ========================

# Environment files (NEVER commit secrets)
.env
.env.local
.env.development
.env.production
server/.env

# Node modules
node_modules/
server/node_modules/
mobile/node_modules/

# TypeScript build output
server/dist/
server/build/

# Expo / React Native
mobile/.expo/
mobile/dist/
mobile/web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS Files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Uploads / temp files
uploads/
tmp/
