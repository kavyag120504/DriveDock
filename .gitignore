# ========================
# DriveDock .gitignore
# ========================

# Environment files (NEVER commit secrets)
.env
.env.local
.env.development
.env.production
server/.env

# Node modules
node_modules/
server/node_modules/
mobile/node_modules/

# TypeScript build output
server/dist/
server/build/

# Expo / React Native
mobile/.expo/
mobile/dist/
mobile/web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS Files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Uploads / temp files
uploads/
tmp/

# Tesseract.js OCR language data, downloaded to cwd on first scan
server/*.traineddata

# Salesforce VS Code / CLI cache (not part of DriveDock)
.sf/

# Seed toolkit — cached data and generated sample images
server/scripts/seed/data/osm_fuel.json
server/scripts/seed/out/
