{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      }
    },
    "pilot": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_BUILD_LABEL": "DriveDock student pilot · test build · synthetic data · test payments only",
        "EXPO_PUBLIC_API_URL": "https://drivedock-pilot-api.onrender.com/api/v1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
