# DriveDock server environment.
# Copy to server/.env for local development (git-ignored). Every value below has a
# safe development default EXCEPT in production, where the security secrets must be
# set to real, unique values or the server refuses to start (see config/env.ts).

# ── Core ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001
# Use a throwaway local DB for dev. In production this MUST be your Atlas URI.
MONGO_URI=mongodb://127.0.0.1:27017/drivedock
# Number of reverse proxies in front of the API (e.g. 1 on Render/Railway/Fly). 0 = direct.
TRUST_PROXY=0
# Browser CORS allowlist (comma-separated origins). Empty = reflect any Origin (dev).
# Set to your web origins in production, e.g. https://app.drivedock.in,https://admin.drivedock.in
# The native mobile app sends no Origin and is unaffected by this setting.
CORS_ALLOWED_ORIGINS=
# Max JSON/urlencoded request body (body-parser byte-string form, e.g. 100kb, 1mb).
# Empty = the 100kb default; an oversized body returns 413. File uploads are capped
# separately by multer (10 MB) and are unaffected by this value.
REQUEST_BODY_LIMIT=

# ── Security secrets (REQUIRED in production — generate with: openssl rand -hex 32) ──
# In dev these can be left unset (insecure built-in defaults apply). In production
# they must be present AND different from the built-in defaults.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
QR_SECRET=
INTERNAL_JOB_SECRET=
TRANSFER_SECRET=
TWIN_SHARE_SECRET=

# ── AWS S3 uploads (optional in dev → local disk; required for durable prod uploads) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=drivedock-documents
AWS_REGION=ap-south-1

# ── Razorpay (sandbox keys first; leave blank to use the dev test-order fallback) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard webhook secret, used to verify POST /api/v1/payments/webhook (payment.captured).
# Leave blank in dev/test (a public placeholder is used); set a REAL value in production —
# the webhook refuses to act on the placeholder in prod so forged events can't confirm bookings.
RAZORPAY_WEBHOOK_SECRET=

# ── Expo push + Google Maps (optional) ──────────────────────────────────────────
EXPO_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# -- Private file links --
# Signs the expiring links the API returns for uploaded files. Set a real value in production.
FILE_URL_SECRET=
FILE_URL_TTL_SECONDS=900

# -- Password reset codes (forgot password) --
# SMS_PROVIDER: log (default, sends nothing) or twilio. EMAIL_PROVIDER: log (default) or smtp.
# A provider with missing credentials falls back to log.
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
EMAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PASSWORD_RESET_TTL_MINUTES=15
# Pilot/demo only: return the code in the API response because no SMS/email account exists. Refused in production.
RESET_CODE_IN_RESPONSE=false

# Paid RC providers (arya, cashfree, idfy, apiexpress) stay blocked unless this is true.
RC_ALLOW_PAID_PROVIDERS=false

# Optional Arya RC verification (backend secret only; disabled by default)
RC_VERIFICATION_ENABLED=false
ARYA_API_TOKEN=
ARYA_RC_DAILY_LIMIT=50

# RC provider when RC_VERIFICATION_ENABLED=true: arya (default), apiexpress, cashfree, idfy or stampmitra
RC_PROVIDER=arya
# API Express key (sk_live_ = production host, sk_test_ = sandbox host). Backend secret only.
APIEXPRESS_API_KEY=
APIEXPRESS_BASE_URL=
APIEXPRESS_RC_DAILY_LIMIT=50
# Cashfree Secure ID (backend secrets). CASHFREE_ENV=sandbox gives free canned test data that never verifies a document.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
CASHFREE_PUBLIC_KEY_PATH=
CASHFREE_RC_DAILY_LIMIT=50
# IDfy RC (ind_rc_plus) via RapidAPI: subscribe to "Vehicle RC Verification Advanced" (Basic = 40 requests/month). Backend secret only.
RAPIDAPI_KEY=
IDFY_RC_HOST=vehicle-rc-verification-advanced.p.rapidapi.com
IDFY_RC_DAILY_LIMIT=10
# StampMitra Verify Vehicle RC (backend secret only). An sk_test_ key is the free sandbox: sample data, shown as "Sandbox test", never changes a document.
STAMPMITRA_API_KEY=
STAMPMITRA_BASE_URL=
STAMPMITRA_RC_DAILY_LIMIT=50
