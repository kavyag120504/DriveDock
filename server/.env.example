# DriveDock server environment.
# Copy to server/.env for local development (git-ignored). Every value below has a
# safe development default EXCEPT in production, where the security secrets must be
# set to real, unique values or the server refuses to start (see config/env.ts).

# ── Core ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001
# Use a throwaway local DB for dev. In production this MUST be your Atlas URI.
MONGO_URI=mongodb://127.0.0.1:27017/drivedock
# Number of reverse proxies in front of the API (e.g. 1 on Render/Railway/Fly). 0 = direct.
TRUST_PROXY=0
# Browser CORS allowlist (comma-separated origins). Empty = reflect any Origin (dev).
# Set to your web origins in production, e.g. https://app.drivedock.in,https://admin.drivedock.in
# The native mobile app sends no Origin and is unaffected by this setting.
CORS_ALLOWED_ORIGINS=
# Max JSON/urlencoded request body (body-parser byte-string form, e.g. 100kb, 1mb).
# Empty = the 100kb default; an oversized body returns 413. File uploads are capped
# separately by multer (10 MB) and are unaffected by this value.
REQUEST_BODY_LIMIT=

# ── Security secrets (REQUIRED in production — generate with: openssl rand -hex 32) ──
# In dev these can be left unset (insecure built-in defaults apply). In production
# they must be present AND different from the built-in defaults.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
QR_SECRET=
INTERNAL_JOB_SECRET=
TRANSFER_SECRET=
TWIN_SHARE_SECRET=

# ── AWS S3 uploads (optional in dev → local disk; required for durable prod uploads) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=drivedock-documents
AWS_REGION=ap-south-1

# ── Razorpay (sandbox keys first; leave blank to use the dev test-order fallback) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Expo push + Google Maps (optional) ──────────────────────────────────────────
EXPO_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
